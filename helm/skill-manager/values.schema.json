{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "description": "Affinity.",
            "additionalProperties": true
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "cacheTTL": {
            "type": "string",
            "description": "How long a source's discovered skills are reused."
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "externalDNSIP": {
            "type": "string"
        },
        "extraArgs": {
            "type": "array",
            "description": "Extra container arguments."
        },
        "extraEnv": {
            "type": "array",
            "description": "Extra environment variables.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "valueFrom": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the fully qualified release name."
        },
        "gcpProject": {
            "type": "string"
        },
        "github": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "apiUrl": {
                    "type": "string",
                    "description": "GitHub API base URL: discovery, pinning, and `GET /user` for a person's GitHub token."
                },
                "app": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "secretName": {
                            "type": "string",
                            "description": "Existing Secret in the release namespace of the read-only skills GitHub App, with the keys `app-id`, `installation-id` and `private-key` (PEM): skills are discovered and pinned with the App's installation tokens, at the App's rate limit. Mutually exclusive with `tokenSecret`."
                        }
                    }
                },
                "tokenSecret": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "key": {
                            "type": "string",
                            "description": "Key of the token in that Secret."
                        },
                        "name": {
                            "type": "string",
                            "description": "Existing Secret in the release namespace with a static GitHub token. Prefer `app`. Empty (and no `app`): anonymous, public repositories only."
                        }
                    }
                }
            }
        },
        "global": {
            "type": "object",
            "description": "Global values shared between all subcharts and the platform.",
            "additionalProperties": true,
            "properties": {
                "podSecurityStandards": {
                    "type": "object",
                    "additionalProperties": true
                }
            }
        },
        "helm": {
            "type": "object",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy."
                },
                "registry": {
                    "type": "string",
                    "description": "Image registry."
                },
                "repository": {
                    "type": "string",
                    "description": "Image repository."
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag. Defaults to the chart appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    }
                }
            }
        },
        "logging": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "verbose": {
                    "type": "boolean",
                    "description": "Enable debug logging."
                }
            }
        },
        "managementCluster": {
            "type": "string"
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "path": {
                    "type": "string",
                    "description": "MCP endpoint path."
                }
            }
        },
        "muster": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mcpServer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "description": {
                            "type": "string",
                            "description": "Human-readable description shown by muster."
                        },
                        "auth": {
                            "type": "object",
                            "description": "How muster authenticates to this server; rendered only with `oauth.enabled`. `forwardToken` makes muster forward the session's Dex id_token byte-identical (the SSO path this chart trusts through its trusted audiences), unless `github.enabled` pins a GitHub App. `requiredAudiences` are extra audiences that token must carry — the Dex cross-client audience the kube-apiserver trusts (`dex-k8s-authenticator` on Giant Swarm clusters; agentlab's is `kubernetes`); muster requests them at login, so users re-login after a change. They are trusted as bearer audiences by construction, since the server's trusted audiences are `oauth.trustedAudiences` plus this list.",
                            "additionalProperties": false,
                            "properties": {
                                "forwardToken": {
                                    "type": "boolean"
                                },
                                "github": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "properties": {
                                        "authorizationServer": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "properties": {
                                                "authorizationEndpoint": {
                                                    "type": "string",
                                                    "description": "GitHub's authorize endpoint."
                                                },
                                                "clientCredentialsSecretRef": {
                                                    "type": "object",
                                                    "additionalProperties": false,
                                                    "properties": {
                                                        "name": {
                                                            "type": "string",
                                                            "description": "Secret with the App's OAuth client under `client-id` and `client-secret`, which muster reads."
                                                        },
                                                        "namespace": {
                                                            "type": "string",
                                                            "description": "Namespace of that Secret; empty is the release namespace."
                                                        }
                                                    }
                                                },
                                                "expectedIssuer": {
                                                    "type": "string",
                                                    "description": "The issuer GitHub puts in the RFC 9207 `iss` parameter. Empty omits the field."
                                                },
                                                "grantScope": {
                                                    "type": "string",
                                                    "description": "`subject`: the grant belongs to the person."
                                                },
                                                "issuer": {
                                                    "type": "string",
                                                    "description": "The issuer identity the person's grant is filed under: the App's own."
                                                },
                                                "scopes": {
                                                    "type": "string",
                                                    "description": "The OAuth `scope` parameter, only for an authorization server that needs one. Empty omits the field."
                                                },
                                                "tokenEndpoint": {
                                                    "type": "string",
                                                    "description": "GitHub's token endpoint."
                                                }
                                            }
                                        },
                                        "enabled": {
                                            "type": "boolean",
                                            "description": "Pin the registration to a GitHub App, as agent-manager's `github.enabled` does: muster runs the App's consent once per person and puts their user token on every call, which this server verifies with `GET /user`; its login opens the private repositories the person can read. `forwardIdentity` puts the Dex ID token in `X-Muster-Id-Token` beside it. Needs `oauth.enabled`. Off: no MCP caller has a GitHub login."
                                        }
                                    }
                                },
                                "requiredAudiences": {
                                    "type": "array"
                                }
                            }
                        },
                        "autoStart": {
                            "type": "boolean",
                            "description": "Start the server connection when muster initializes."
                        },
                        "displayName": {
                            "type": "string",
                            "description": "Name the Dev Portal shows for this server, rendered as the MCPServer's `ui.giantswarm.io/display-name` annotation. Empty renders no annotation."
                        },
                        "enabled": {
                            "type": "boolean",
                            "description": "Register this server with muster by rendering an `mcpservers.muster.giantswarm.io` CR in the release namespace. Tools then appear as `x_<name>_<tool>`."
                        },
                        "labels": {
                            "type": "object",
                            "description": "Extra labels on the MCPServer CR.",
                            "additionalProperties": true
                        },
                        "name": {
                            "type": "string",
                            "description": "MCPServer CR name (drives the tool prefix)."
                        },
                        "timeout": {
                            "type": [
                                "integer",
                                "null"
                            ],
                            "description": "How long muster waits for a tool's answer, in seconds (the MCPServer's `spec.timeout`, 1 to 300); unset keeps muster's default, 30 seconds.",
                            "maximum": 300,
                            "minimum": 1
                        }
                    }
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Override the chart name."
        },
        "networkPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowInternet": {
                    "type": "boolean",
                    "description": "Allow egress on 443 to every destination: GitHub, OCI registries and Dex. Vanilla NetworkPolicy cannot select by name; narrow with egressCIDRs instead when the addresses are known."
                },
                "egressCIDRs": {
                    "type": "array",
                    "description": "Extra egress CIDRs."
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Create a Kubernetes NetworkPolicy for the pod (off when an umbrella chart renders the policies)."
                },
                "ingressNamespaces": {
                    "type": "array",
                    "description": "Namespaces allowed to reach the MCP endpoint (label kubernetes.io/metadata.name). Empty allows ingress from the release namespace only."
                },
                "metricsNamespaces": {
                    "type": "array",
                    "description": "Namespaces allowed to scrape the metrics port (label kubernetes.io/metadata.name), when `observability.metrics.enabled`.",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector.",
            "additionalProperties": true
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPublicClientRegistration": {
                    "type": "boolean",
                    "description": "Accept unauthenticated dynamic client registration (labs only)."
                },
                "baseURL": {
                    "type": "string",
                    "description": "Public base URL of this server: the issuer of its own OAuth metadata (https, or http on loopback). Empty derives `https://<fullname>.<global.domain>` when `global.domain` is set."
                },
                "dex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateURLs": {
                            "type": "boolean",
                            "description": "Let the issuer resolve to a private or loopback address (an in-cluster Dex)."
                        },
                        "caSecret": {
                            "type": "object",
                            "description": "Secret with the CA of a Dex that serves a private certificate; mounted and passed as the `dex-ca-file` flag. Empty name falls back to `global.identity.ca.secretName` / `global.identity.ca.key`.",
                            "additionalProperties": false,
                            "properties": {
                                "key": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            }
                        },
                        "clientID": {
                            "type": "string",
                            "description": "Dex OAuth client ID. Empty falls back to `global.identity.clientId`."
                        },
                        "clientSecret": {
                            "type": "string",
                            "description": "Dex OAuth client secret (prefer `oauth.existingSecret`)."
                        },
                        "issuerURL": {
                            "type": "string",
                            "description": "Dex issuer URL. Empty falls back to `global.identity.issuerUrl`."
                        }
                    }
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Make skill-manager an OAuth 2.1 resource server (mcp-oauth): the MCP endpoint and the REST API require a bearer token Dex issued, validated against Dex's JWKS when its audience is in `trustedAudiences`. muster forwards the session's Dex id_token (`muster.mcpServer.auth`); agent-manager and the portal forward the person's. A REST call may instead carry the person's GitHub token as the bearer and the id_token in `X-Muster-Id-Token`, as agent-manager forwards them on its GitHub registration: the GitHub login then opens the private repositories the person can read. Off: no caller, and private repositories are refused; only for a server nothing but a trusted proxy can reach."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the Dex client secret under `dex-client-secret`. Empty falls back to `global.identity.existingSecret`; without that, the chart renders a Secret from `oauth.dex.clientSecret`."
                },
                "sso": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateIPs": {
                            "type": "boolean",
                            "description": "Let Dex's JWKS endpoint resolve to a private address when validating forwarded tokens (an in-cluster Dex)."
                        }
                    }
                },
                "trustedAudiences": {
                    "type": "array",
                    "description": "OAuth client IDs whose Dex id_tokens are accepted as bearer tokens (SSO token forwarding). Empty falls back to `[global.identity.clientId]`, the platform client MCP clients and the muster CLI log in with. The server trusts the union of this list and `muster.mcpServer.auth.requiredAudiences` (in that order, without duplicates): every token muster forwards carries the required audiences by construction and they are what the kube-apiserver trusts, so a portal session — whose id_token carries them but not the platform client — is accepted without listing its client here."
                }
            }
        },
        "observability": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "metrics": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Serve Prometheus metrics on `GET /metrics` of the `metrics` port: `mcp_server_operation_duration_seconds` per tool and `http_server_request_duration_seconds` for the MCP endpoint. Off, `OTEL_METRICS_EXPORTER=none`: nothing is served."
                        },
                        "port": {
                            "type": "integer",
                            "description": "Port of the metrics listener, apart from the MCP port so the OAuth guard never covers it."
                        }
                    }
                },
                "otel": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "description": "OTLP collector URL for traces, e.g. `http://otlp-gateway.kube-system.svc:4317` (gRPC) or `https://tempo.example.com:4318` (with protocol `http/protobuf`). Empty exports nothing; inbound `traceparent` headers still propagate. With `networkPolicy.enabled` the policy opens egress to it: the Service's namespace for an in-cluster host, every address otherwise."
                        },
                        "headers": {
                            "type": "string",
                            "description": "OTLP headers (`OTEL_EXPORTER_OTLP_HEADERS`), e.g. `X-Scope-OrgID=giantswarm` for a multi-tenant collector."
                        },
                        "protocol": {
                            "type": "string",
                            "description": "OTLP protocol: `grpc` or `http/protobuf`.",
                            "enum": [
                                "grpc",
                                "http/protobuf"
                            ]
                        },
                        "resourceAttributes": {
                            "type": "string",
                            "description": "Resource attributes appended to the downward-API `k8s.pod.name`, `k8s.namespace.name` and `k8s.node.name`."
                        },
                        "sampler": {
                            "type": "string",
                            "description": "`OTEL_TRACES_SAMPLER`. The parent-based default follows the caller's sampling decision and samples `samplerArg` of the traces that start here."
                        },
                        "samplerArg": {
                            "type": "string",
                            "description": "`OTEL_TRACES_SAMPLER_ARG`."
                        }
                    }
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations on the pod.",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "description": "Labels on the pod.",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod security context.",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer",
            "description": "Number of replicas. The server keeps no MCP session state, so two or more are fine; each keeps its own discovery cache."
        },
        "resources": {
            "type": "object",
            "description": "Container resources.",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "ephemeral-storage": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "revisionHistoryLimit": {
            "type": "integer",
            "description": "Number of old ReplicaSets retained for rollback."
        },
        "securityContext": {
            "type": "object",
            "description": "Container security context.",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type."
                },
                "port": {
                    "type": "integer",
                    "description": "Service port (the container listens on 8080)."
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the ServiceAccount.",
                    "additionalProperties": true
                },
                "create": {
                    "type": "boolean",
                    "description": "Create a ServiceAccount."
                },
                "name": {
                    "type": "string",
                    "description": "ServiceAccount name (generated when empty)."
                }
            }
        },
        "serviceMonitor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "enabled": {
                    "type": "boolean",
                    "description": "Render a ServiceMonitor for the `metrics` port. Also needs `observability.metrics.enabled`."
                },
                "interval": {
                    "type": "string",
                    "description": "Scrape interval; empty uses the Prometheus Operator default."
                },
                "labels": {
                    "type": "object",
                    "description": "Labels on the ServiceMonitor, beside the chart's own. The Giant Swarm observability platform routes a scrape to a Mimir tenant by `observability.giantswarm.io/tenant`; a monitor without it writes to no tenant.",
                    "additionalProperties": true
                }
            }
        },
        "serviceToken": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "key": {
                    "type": "string",
                    "description": "Key of the token in that Secret."
                },
                "secretName": {
                    "type": "string",
                    "description": "Existing Secret in the release namespace with a bearer the REST API admits as the platform's own caller, no person, for agent-manager's `migrate`; no readability check applies to it. Needs `oauth.enabled`. Empty: none."
                }
            }
        },
        "sources": {
            "type": "array",
            "description": "The skill sources: each a github.com repository URL or `{url, ref, path, readOnly}`. `ref` is a branch, tag or commit (empty: the default branch): what discovery reads and what a skill of the source without its own ref pins. `path` is the directory scanned (empty: the whole repository). `readOnly` is reported, not enforced. A repository given twice needs paths that do not contain each other.",
            "items": {
                "type": [
                    "string",
                    "object"
                ],
                "required": [
                    "url"
                ],
                "additionalProperties": false,
                "properties": {
                    "path": {
                        "type": "string"
                    },
                    "readOnly": {
                        "type": "boolean"
                    },
                    "ref": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string",
                        "pattern": "^https://github\\.com/[^/]+/[^/]+$"
                    }
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "effect": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "tolerationSeconds": {
                        "type": "integer"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
